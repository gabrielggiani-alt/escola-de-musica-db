# Copie este arquivo para .env e troque as senhas.
# O .env esta no .gitignore: as senhas reais nunca vao para o repositorio.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=escola_musica

# Senha do root do MySQL, usada SO por ferramentas/criar_usuarios_banco.py.
# Pode deixar comentado: o script pergunta na hora.
# DB_ROOT_PASSWORD=

# Senhas dos usuarios do MySQL que a aplicacao usa (um por perfil)
DB_SENHA_LOGIN=troque-esta-senha-1
DB_SENHA_ADMIN=troque-esta-senha-2
DB_SENHA_SECRETARIA=troque-esta-senha-3
DB_SENHA_PROFESSOR=troque-esta-senha-4

# Chave que assina o cookie de sessao do Flask
FLASK_SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
